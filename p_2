/*  Create the file  :nano p_2.l
than Paste the LEX program, then save and exit.*/
%{
#include <stdio.h>
%}

%%
"int"|"float"|"char"|"if"|"else"|"while"|"for"|"return"
                    { printf("%s : Keyword\n", yytext); }

[a-zA-Z_][a-zA-Z0-9_]* 
                    { printf("%s : Identifier\n", yytext); }

[0-9]+              { printf("%s : Number\n", yytext); }

"+"|"-"|"*"|"/"|"=" { printf("%s : Operator\n", yytext); }

[;,(){}]            { printf("%s : Special Symbol\n", yytext); }

[ \t\n]+            { /* Ignore whitespace */ }

.                   { printf("%s : Unknown Symbol\n", yytext); }
%%

int main()
{
    printf("Enter a statement:\n");
    yylex();
    return 0;
}

int yywrap()
{
    return 1;
}


/* Compile the generated C program
gcc lex.yy.c -o p_2 -ll

input :int a = 10 + b;

output : Enter a statement:

int a = 10 + b;
int : Keyword
a : Identifier
= : Operator
10 : Number
+ : Operator
b : Identifier
; : Special Symbol
*/

